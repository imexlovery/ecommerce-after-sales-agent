# Explicit runtime mode. Mock never contacts DeepSeek; Live never falls back to Mock.
LLM_MODE=mock

# Live-only. Leave empty in this example and supply locally in .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# Mock-only visual pacing. It never delays Live calls or SSE replay.
MOCK_DEMO_STEP_DELAY_MS=300
SYNTHETIC_FAULT_PROFILE=none
SCENARIO_FAULT_SEED=demo-default

# Local prototype storage.
DATABASE_URL=sqlite:///./var/after-sales.db
LANGGRAPH_CHECKPOINT_URL=./var/langgraph-checkpoints.db
EVAL_ARTIFACT_ROOT=./var/evals
FIXTURE_VERSION=fixture-v1
SCENARIO_EVALUATED_AT=2026-08-23T12:00:00+00:00

# Loopback-only supported profile.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO
